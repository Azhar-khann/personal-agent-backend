# Copy to .env and adjust. `pnpm db:up` serves both of these locally.
# Non-default ports, to avoid colliding with a Homebrew postgres on 5432.
DATABASE_URL=postgresql://personal_agent:personal_agent@localhost:5433/personal_agent
REDIS_URL=redis://localhost:6380

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Clerk. Locally, use the keys of your Clerk development instance.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# The frontend's origin(s), comma-separated.
CORS_ORIGINS=http://localhost:3000

# Clerk user ID of the first admin, used by db:seed. Without one, no business
# can ever be approved.
ADMIN_BOOTSTRAP_CLERK_USER_ID=

# The chat agent: one structured OpenAI call per message.
OPENAI_API_KEY=
AGENT_MODEL=gpt-5.6-terra
AGENT_REASONING_EFFORT=low

# Web push to business staff browsers. Generate a key pair once with:
#   node -e 'console.log(require("web-push").generateVAPIDKeys())'   (from apps/worker)
# The subject is a contact for push services: mailto: or https://.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# LangSmith traces each chat message. Leave LANGSMITH_TRACING unset to turn it off.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=personal-agent

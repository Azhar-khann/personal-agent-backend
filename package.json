{
  "name": "personal-agent-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck && tsc --noEmit -p tsconfig.json",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "evals": "pnpm --filter @personal-agent/api evals",
    "metrics": "pnpm --filter @personal-agent/api metrics",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "dev:api": "pnpm --filter @personal-agent/api dev",
    "dev:worker": "pnpm --filter @personal-agent/worker dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
